# Inject environment variables through your supervisor; never commit real values.
SOURCE_RPC_URL=
DESTINATION_RPC_URL=
# Inclusive first source block; choose at/before the first relevant DecisionRecorded.
SOURCE_START_BLOCK=
# At/before escrow deployment, for bounded historical event-proof queries.
DESTINATION_START_BLOCK=
# Optional: defaults to 500 (maximum 2000).
MAX_BLOCKS=
# Optional: defaults to 2, minimum 2. Does not assume Arc supports finalized.
DESTINATION_CONFIRMATIONS=
# Optional: dedicated private directory, defaults to packages/relayer/state.
RELAYER_STATE_DIR=
# Only read when the CLI receives the exact --broadcast argument.
RELAYER_PRIVATE_KEY=