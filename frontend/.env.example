# Public Privy application ID for wallet connection.
# NEXT_PUBLIC_* values are inlined at build time: change it, then rebuild before `npm run start`.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional server-only RPC overrides. Public endpoints are used when unset.
# Never prefix a credential with NEXT_PUBLIC_.
SEPOLIA_RPC_URL=
ARC_RPC_URL=
